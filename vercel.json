{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes --package=bun@1.4.2 bun install --frozen-lockfile",
  "buildCommand": "npx --yes --package=bun@1.4.2 bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ]
}
