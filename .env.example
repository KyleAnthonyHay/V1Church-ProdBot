# Frontend + CLI configuration only. Copy to .env.local.
CONVEX_DEPLOYMENT=dev:<your-deployment>
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud

# Set these in Convex deployment Settings > Environment Variables:
# OPENAI_API_KEY (secret; do not put in frontend or Vercel build variables)
# AGENT_MODEL=gpt-5.6-luna
# AGENT_EFFORT=medium
# GENERATE_EFFORT=high
